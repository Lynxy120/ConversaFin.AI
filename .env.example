# App
APP_ENV=development
APP_PORT=8000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-meta-access-token
WA_VERIFY_TOKEN=your-random-webhook-verify-token
WA_APP_SECRET=your-meta-app-secret
WA_WABA_ID=your-whatsapp-business-account-id
WA_GRAPH_VERSION=v23.0

# WhatsApp Business
WA_OWNER_NUMBER=628xxxxxxxxxx
WA_CATALOG_ID=your-catalog-id

# Application security
ADMIN_API_KEY=your-random-64-character-hex-key

# Product catalog
CATALOG_LINK_BASE=https://example.com/products
CATALOG_BRAND=ConversaFin

# Development mode
WA_DRY_RUN=true

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false